        <span>Sell Item</span>
    </a>

    <script type="module">
        // ─── Dynamic API base (uses the same host, port 8000) ───
        const API_BASE = (() => {
            const { protocol, hostname } = window.location;
            return `${protocol}//${hostname}:8000/api`;
        })();

        // ─── Helpers ──────────────────────────────────────────────
        function getInitials(name) {
            if (!name) return '?';
            const parts = name.trim().split(/\s+/);
            if (parts.length === 1) return parts[0].charAt(0);
            return (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
        }

        function stringToColor(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                hash = str.charCodeAt(i) + ((hash << 5) - hash);
            }
            const hue = Math.abs(hash) % 360;
            return `hsl(${hue}, 70%, 55%)`;
        }

        function showToast(msg, type = 'info') {
            console.log(`[${type}] ${msg}`);
        }

        function getToken() {
            return localStorage.getItem('authToken');
        }

        function removeToken() {
            localStorage.removeItem('authToken');
        }

        async function authFetch(url, options = {}) {
            const token = getToken();
            if (!token) {
                throw new Error('No authentication token found');
            }
            const headers = {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json',
                ...options.headers,
            };
            const response = await fetch(url, { ...options, headers });
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP ${response.status}: ${errorText}`);
            }
            return response;
        }

        async function checkAuth() {
            const token = getToken();
            if (!token) return null;
            try {
                const res = await authFetch(`${API_BASE}/users/me`);
                const user = await res.json();
                return user;
            } catch (err) {
                console.warn('Auth check failed:', err);
                return null;
            }
        }

        function logout() {
            removeToken();
            window.location.href = 'login.html';
        }

        function renderProductGrid(containerId, products) {
            const container = document.getElementById(containerId);
            if (!container) return;

            if (!products || products.length === 0) {
                container.innerHTML = `<div class="text-dim" style="grid-column:1/-1;padding:40px 0;text-align:center;">Your wishlist is empty.</div>`;
                return;
            }

            container.innerHTML = products.map(p => `
                <div class="product-card" style="border:1px solid #eee;border-radius:16px;padding:12px;text-align:center;background:#fff;transition:0.2s;">
                    <img src="${p.images && p.images.length > 0 ? p.images[0] : 'https://via.placeholder.com/160'}" alt="${p.title}" style="width:100%;height:120px;object-fit:cover;border-radius:12px;margin-bottom:8px;" />
                    <div style="font-weight:500;font-size:0.95rem;">${p.title}</div>
                    <div style="color:#2563eb;font-weight:600;margin-top:4px;">₹${p.price.toFixed(2)}</div>
                    <button class="btn btn-primary btn-sm" style="margin-top:8px;">Add to Cart</button>
                </div>
            `).join('');
        }

        // ─── Main ───────────────────────────────────────────────────
        (async function init() {
            const user = await checkAuth();
            if (!user) {
                window.location.href = 'login.html';
                return;
            }

            // Navbar avatar
            const navAvatar = document.getElementById('nav-avatar');
            const loginBtn = document.getElementById('login-btn');
            if (user.name) {
                const initial = getInitials(user.name);
                navAvatar.textContent = initial;
                navAvatar.style.background = stringToColor(user.name);
                navAvatar.style.display = 'inline-flex';
                loginBtn.style.display = 'none';
            }

            // Logout handlers
            document.getElementById('logout-btn').addEventListener('click', logout);
            document.getElementById('mobile-logout-btn').addEventListener('click', logout);

            // Profile
            const nameEl = document.getElementById('user-name');
            const emailEl = document.getElementById('user-email');
            const pictureEl = document.getElementById('user-picture');
            const letterEl = document.getElementById('avatar-letter');

            const name = user.name || 'User';
            const email = user.email || '';
            const picture = user.picture || '';

            nameEl.textContent = name;
            emailEl.textContent = email;

            if (picture && picture.trim() !== '') {
                pictureEl.src = picture;
                pictureEl.style.display = 'block';
                letterEl.style.display = 'none';
            } else {
                pictureEl.style.display = 'none';
                const initial = getInitials(name);
                letterEl.textContent = initial;
                letterEl.style.background = stringToColor(name);
                letterEl.style.display = 'flex';
            }

            // Orders
            try {
                const res = await authFetch(`${API_BASE}/orders`);
                const orders = await res.json();
                const container = document.getElementById('orders-list');
                if (!orders || orders.length === 0) {
                    container.innerHTML = `<p class="text-dim" style="padding:8px 0;">No orders yet.</p>`;
                } else {
                    container.innerHTML = orders.map(o => {
                        const statusClass = o.status === 'pending' ? 'pending' :
                                           o.status === 'shipped' ? 'shipped' : '';
                        return `
                            <div class="review-row">
                                <span class="order-id">Order #${o.id.substring(0, 8)}</span>
                                <span class="order-status ${statusClass}">${o.status || 'Placed'}</span>
                                <span class="order-date">${new Date(o.created_at).toLocaleDateString()}</span>
                            </div>
                        `;
                    }).join('');
                }
            } catch (err) {
                showToast('Failed to load orders: ' + err.message, 'error');
                document.getElementById('orders-list').innerHTML =
                    `<p class="text-dim" style="padding:8px 0;">Could not load orders. Please try again later.</p>`;
            }

            // Wishlist
            try {
                const res = await authFetch(`${API_BASE}/wishlist`);
                const products = await res.json();
                renderProductGrid('wishlist-grid', products);
            } catch (err) {
                showToast('Failed to load wishlist: ' + err.message, 'error');
                document.getElementById('wishlist-grid').innerHTML =
                    `<div class="text-dim" style="grid-column:1/-1;padding:40px 0;text-align:center;">Could not load wishlist.</div>`;
            }
        })();
    </script>

</body>
</html>
</file>

