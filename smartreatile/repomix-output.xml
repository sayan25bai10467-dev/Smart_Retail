    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #6c5ce7;
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  .avatar-circle:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(108, 92, 231, 0.35);
  }
  @media (max-width: 768px) {
    .avatar-circle {
      width: 32px;
      height: 32px;
      font-size: 14px;
    }
  }
</style>

<script type="module">
import { getProducts, renderProductGrid } from './js/products.js';
import { checkAuth, logout } from './js/app.js';

// ─── Helper to get first letter and color ───
function getInitials(name) {
  if (!name) return '?';
  return name.trim().charAt(0).toUpperCase();
}

function stringToColor(str) {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = str.charCodeAt(i) + ((hash << 5) - hash);
  }
  const hue = Math.abs(hash) % 360;
  return `hsl(${hue}, 70%, 55%)`;
}

// ─── Check authentication and update navbar ───
(async function() {
  const user = await checkAuth();
  const loginBtn = document.getElementById('login-btn');
  const dashboardBtn = document.getElementById('dashboard-btn');
  const avatarEl = document.getElementById('user-avatar');
  const mobileLogin = document.getElementById('mobile-login-link');
  const mobileDashboard = document.getElementById('mobile-dashboard-link');
  const mobileLogout = document.getElementById('mobile-logout-btn');

  if (user) {
    // Logged in
    loginBtn.style.display = 'none';
    dashboardBtn.style.display = 'inline-flex';
    avatarEl.style.display = 'inline-flex';

    // Set avatar text and background
    const name = user.name || 'User';
    const initial = getInitials(name);
    avatarEl.textContent = initial;
    avatarEl.style.background = stringToColor(name);

    // Click avatar → go to dashboard
    avatarEl.addEventListener('click', () => {
      window.location.href = 'dashboard.html';
    });

    mobileLogin.style.display = 'none';
    mobileDashboard.style.display = 'block';
    mobileLogout.style.display = 'block';
    mobileLogout.addEventListener('click', logout);
  } else {
    // Logged out
    loginBtn.style.display = 'inline-flex';
    dashboardBtn.style.display = 'none';
    avatarEl.style.display = 'none';
    mobileLogin.style.display = 'block';
    mobileDashboard.style.display = 'none';
    mobileLogout.style.display = 'none';
  }
})();

// ─── Load products ──────────────────────────────────
(async function() {
  const featured = await getProducts({ sort: 'recent', limit: 4 });
  renderProductGrid('featured-grid', featured);
  const recent = await getProducts({ sort: 'recent', limit: 4, skip: 4 });
  renderProductGrid('recent-grid', recent);
  const trending = await getProducts({ sort: 'popular', limit: 4 });
  renderProductGrid('trending-grid', trending);
})();
</script>
</body>
</html>
</file>

